    VOL[["<b>volumen</b><br/>mongo_data → /data/db"]]:::vol
    SEED[["<b>semilla</b><br/>./mongo/init → /docker-entrypoint-initdb.d"]]:::vol
  end

  BR -->|"HTTP :8080"| FE
