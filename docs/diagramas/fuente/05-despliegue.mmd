    direction LR
    subgraph NET["Red bridge: adopcion-net"]
      direction LR
      FE["<b>frontend</b> · adopcion-frontend<br/>[build node:22-alpine → nginx:1.27-alpine]<br/>SPA compilada (vite build)<br/>/api/* → backend:8000 (quita /api)<br/>puerto 8080:80"]:::container
      BE["<b>backend</b> · adopcion-backend<br/>[FastAPI + Uvicorn · Python 3.12]<br/>MONGO_URI con authSource=admin<br/>healthcheck GET /health<br/>puerto 8000:8000"]:::container
