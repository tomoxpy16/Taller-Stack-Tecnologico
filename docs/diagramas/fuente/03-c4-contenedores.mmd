flowchart TB
  classDef person fill:#08427B,stroke:#052E56,color:#fff
  classDef container fill:#438DD5,stroke:#2E6295,color:#fff
  classDef db fill:#438DD5,stroke:#2E6295,color:#fff
  classDef ext fill:#999999,stroke:#6B6B6B,color:#fff

  A["<b>Adoptante</b><br/>[Persona]"]:::person
  R["<b>Refugio</b><br/>[Persona]"]:::person

  subgraph SYS["Plataforma de Adopción de Mascotas [Sistema]"]
    direction TB
    WEB["<b>Web App</b><br/>[Contenedor: Nginx]<br/><br/>Sirve los archivos estáticos de la SPA<br/>y hace proxy de /api hacia el backend"]:::container
    SPA["<b>Single-Page Application</b><br/>[Contenedor: Vue.js 3 / JavaScript]<br/><br/>Catálogo, ficha, formulario de postulación<br/>y panel reactivo del refugio"]:::container
    API["<b>API de Adopciones</b><br/>[Contenedor: Python · FastAPI · Uvicorn]<br/><br/>Arquitectura hexagonal: expone los casos de uso<br/>vía REST / JSON:API y aplica las reglas de negocio"]:::container
    DB[("<b>Base de datos</b><br/>[Contenedor: MongoDB]<br/><br/>Colecciones refugios, animals,<br/>adoptantes, postulaciones")]:::db
  end

  IMG["<b>Servicio de imágenes</b><br/>[Sistema externo]"]:::ext

  A -->|"Usa<br/>[HTTPS]"| WEB
  R -->|"Usa<br/>[HTTPS]"| WEB
  WEB -->|"Entrega al navegador"| SPA
  SPA -->|"Llama API<br/>[JSON:API / HTTPS]"| API
  API -->|"Lee y escribe<br/>[Motor · Mongo wire protocol]"| DB
  SPA -.->|"Carga fotos<br/>[HTTPS]"| IMG
