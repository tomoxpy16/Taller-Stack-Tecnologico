---
title: Sistema de Adopción de Mascotas — Arquitectura de Alto Nivel (HLD) · Hexagonal
---
flowchart LR
  classDef actor fill:#111317,stroke:#9aa0a6,color:#f5f5f5,stroke-width:1.5px
  classDef fe fill:#111317,stroke:#4fc3f7,color:#f5f5f5,stroke-width:1.5px
  classDef adapter fill:#2b1d10,stroke:#e0a050,color:#f5f5f5,stroke-width:1.5px
  classDef core fill:#111317,stroke:#66bb6a,color:#f5f5f5,stroke-width:1.5px
  classDef port fill:#111317,stroke:#66bb6a,color:#c8e6c9,stroke-width:2px,stroke-dasharray:5 3
  classDef db fill:#0f2624,stroke:#26a69a,color:#f5f5f5,stroke-width:1.5px

  subgraph USR["Superficies de interacción"]
    direction TB
    R(["Refugio"]):::actor
    A(["Adoptante"]):::actor
  end

  subgraph DOCKER["Docker Compose — red bridge adopcion-net (3 contenedores)"]
    direction LR
    subgraph FE["Contenedor frontend · Nginx :8080"]
      SPA["<b>SPA Vue.js 3</b><br/>Catálogo · Ficha · Postulación<br/>Mis postulaciones · Panel del refugio"]:::fe
    end

    subgraph BE["Contenedor backend · FastAPI + Uvicorn :8000"]
      direction LR
      IN["<b>Adaptador de entrada</b><br/>Routers REST / JSON:API<br/>+ exception handlers"]:::adapter
      subgraph HEX["Núcleo hexagonal — sin dependencias de infraestructura"]
        direction TB
        UC["<b>Casos de uso</b><br/>PublicarAnimal · Postular<br/>AprobarPostulación · Rechazar"]:::core
        DOM["<b>Dominio</b><br/>Refugio · Animal · Adoptante · Postulación<br/>Reglas: disponibilidad, única activa,<br/>cierre automático"]:::core
        P["<b>Puertos (typing.Protocol)</b><br/>AnimalRepository · PostulacionRepository<br/>AdoptanteRepository · RefugioRepository"]:::port
        UC --> DOM
        UC --> P
      end
      OUT["<b>Adaptadores de salida</b><br/>Mongo (Motor)<br/>In-memory (tests)"]:::adapter
      IN -->|"invoca"| UC
      OUT -.->|"implementa"| P
    end

    subgraph DB["Contenedor mongodb · volumen mongo_data"]
      M[("<b>MongoDB 7</b><br/>refugios · animales<br/>adoptantes · postulaciones")]:::db
    end
  end

  R -->|"HTTPS"| SPA
  A -->|"HTTPS"| SPA
  SPA -->|"REST · application/vnd.api+json<br/>Nginx reenvía /api"| IN
  OUT -->|"Mongo wire protocol"| M

